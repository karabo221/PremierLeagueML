<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Worksheet</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>   <thead> <tr class="over_header"> <th aria-label="" data-stat="" colspan="3" class=" over_header center"></th> <th aria-label="" data-stat="header_playing" colspan="5" class=" over_header center group_start">Playing Time</th> <th aria-label="" data-stat="header_starts" colspan="3" class=" over_header center group_start">Starts</th> <th aria-label="" data-stat="header_subs" colspan="3" class=" over_header center group_start">Subs</th> <th aria-label="" data-stat="header_team_success" colspan="5" class=" over_header center group_start">Team Success</th> </tr> <tr> <th aria-label="Squad" data-stat="team" scope="col" class=" poptip sort_default_asc center">Squad</th> <th aria-label="# of Players" data-stat="players_used" scope="col" class=" poptip center" data-tip="&lt;strong&gt;# of Players&lt;/strong&gt;&lt;br&gt;Number of Players used in Games"># Pl</th> <th aria-label="Average Age" data-stat="avg_age" scope="col" class=" poptip sort_default_asc center" data-tip="&lt;strong&gt;Average Age&lt;/strong&gt;&lt;br&gt;Age is weighted by minutes played">Age</th> <th aria-label="Matches Played" data-stat="games" scope="col" class=" poptip center group_start" data-tip="&lt;strong&gt;Matches Played&lt;/strong&gt;&lt;br&gt;Matches Played by the player or squad" data-over-header="Playing Time">MP</th> <th aria-label="Minutes" data-stat="minutes" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Minutes&lt;/strong&gt;&lt;br&gt;" data-over-header="Playing Time">Min</th> <th aria-label="Minutes Per Match Played" data-stat="minutes_per_game" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Minutes Per Match Played&lt;/strong&gt;&lt;br&gt;Minutes Per Match Played" data-over-header="Playing Time">Mn/MP</th> <th aria-label="Percentage of Squad Minutes Played" data-stat="minutes_pct" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Percentage of Squad Minutes Played&lt;/strong&gt;&lt;br&gt;&lt;strong&gt;Percentage of Minutes Played&lt;/strong&gt;&lt;br&gt;Percentage of team's total minutes in which player was on the pitch&lt;br&gt;Player minutes played divided by team total minutes played&lt;br&gt;Minimum 30 minutes played per squad game to qualify as a leader" data-over-header="Playing Time">Min%</th> <th aria-label="90s Played" data-stat="minutes_90s" scope="col" class=" poptip center" data-tip="&lt;strong&gt;90s Played&lt;/strong&gt;&lt;br&gt;&lt;strong&gt;90s played&lt;/strong&gt;&lt;br&gt;Minutes played divided by 90" data-over-header="Playing Time">90s</th> <th aria-label="Starts" data-stat="games_starts" scope="col" class=" poptip center group_start" data-tip="Game or games started by player" data-over-header="Starts">Starts</th> <th aria-label="Minutes Per Match Started" data-stat="minutes_per_start" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Minutes Per Match Started&lt;/strong&gt;&lt;br&gt;Minutes Per Match Started&lt;br&gt;Minimum 30 minutes played per squad game to qualify as a leader" data-over-header="Starts">Mn/Start</th> <th aria-label="Complete Matches Played" data-stat="games_complete" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Complete Matches Played&lt;/strong&gt;&lt;br&gt;Complete matches played" data-over-header="Starts">Compl</th> <th aria-label="Substitute Appearances" data-stat="games_subs" scope="col" class=" poptip center group_start" data-tip="&lt;strong&gt;Substitute Appearances&lt;/strong&gt;&lt;br&gt;Games as sub&lt;br&gt;Game or games player did not start, so as a substitute" data-over-header="Subs">Subs</th> <th aria-label="Minutes Per Substitution" data-stat="minutes_per_sub" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Minutes Per Substitution&lt;/strong&gt;&lt;br&gt;Minutes Per Substitution&lt;br&gt;Minimum 30 minutes played per squad game to qualify as a leader" data-over-header="Subs">Mn/Sub</th> <th aria-label="Matches as Unused Sub" data-stat="unused_subs" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Matches as Unused Sub&lt;/strong&gt;&lt;br&gt;Games as an unused substitute" data-over-header="Subs">unSub</th> <th aria-label="Points per Match" data-stat="points_per_game" scope="col" class=" poptip hide_non_quals center group_start" data-tip="&lt;strong&gt;Points per Match&lt;/strong&gt;&lt;br&gt;&lt;strong&gt;Points per Match&lt;/strong&gt;&lt;br&gt;Average number of points earned by the team from matches in which the player appeared&lt;br&gt;Minimum 30 minutes played per squad game to qualify as a leader" data-over-header="Team Success" data-filter="1" data-name="Points per Match">PPM</th> <th aria-label="Goals Scored (on pitch)" data-stat="on_goals_for" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Goals Scored (on pitch)&lt;/strong&gt;&lt;br&gt;Goals scored by team while on pitch" data-over-header="Team Success">onG</th> <th aria-label="Goals Allowed (on pitch)" data-stat="on_goals_against" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Goals Allowed (on pitch)&lt;/strong&gt;&lt;br&gt;Goals allowed by team while on pitch" data-over-header="Team Success">onGA</th> <th aria-label="Plus/Minus" data-stat="plus_minus" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Plus/Minus&lt;/strong&gt;&lt;br&gt;&lt;strong&gt;Plus/Minus&lt;/strong&gt;&lt;br&gt;Goals scored minus goals allowed by the team while the player was on the pitch." data-over-header="Team Success">+/-</th> <th aria-label="Plus/Minus/90" data-stat="plus_minus_per90" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Plus/Minus/90&lt;/strong&gt;&lt;br&gt;&lt;strong&gt;Plus/Minus per 90 Minutes&lt;/strong&gt;&lt;br&gt;Goals scored minus goals allowed by the team while the player was on the pitch per 90 minutes played.&lt;br&gt;Minimum 30 minutes played per squad game to qualify as a leader" data-over-header="Team Success" data-filter="1" data-name="Plus/Minus/90">+/-90</th> </tr> </thead> <tbody> <tr data-row="0"><th scope="row" class="left " data-stat="team">Arsenal</th><td class="right " data-stat="players_used">25</td><td class="center " data-stat="avg_age">26.0</td><td class="right group_start" data-stat="games">38</td><td class="right " data-stat="minutes" csk="3420">3,420</td><td class="right " data-stat="minutes_per_game">90</td><td class="right " data-stat="minutes_pct">100</td><td class="right " data-stat="minutes_90s">38.0</td><td class="right group_start" data-stat="games_starts">418</td><td class="right " data-stat="minutes_per_start">81</td><td class="right " data-stat="games_complete">254</td><td class="right group_start" data-stat="games_subs">167</td><td class="right " data-stat="minutes_per_sub">23</td><td class="right " data-stat="unused_subs">175</td><td class="right group_start" data-stat="points_per_game">2.24</td><td class="right " data-stat="on_goals_for">71</td><td class="right " data-stat="on_goals_against">27</td><td class="right plus" data-stat="plus_minus" csk="44">+44</td><td class="right plus" data-stat="plus_minus_per90">+1.16</td></tr> <tr data-row="1"><th scope="row" class="left " data-stat="team">Aston Villa</th><td class="right " data-stat="players_used">30</td><td class="center " data-stat="avg_age">28.0</td><td class="right group_start" data-stat="games">38</td><td class="right " data-stat="minutes" csk="3420">3,420</td><td class="right " data-stat="minutes_per_game">90</td><td class="right " data-stat="minutes_pct">100</td><td class="right " data-stat="minutes_90s">38.0</td><td class="right group_start" data-stat="games_starts