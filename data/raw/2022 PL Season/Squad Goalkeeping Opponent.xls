<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Worksheet</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>   <thead> <tr class="over_header"> <th aria-label="" data-stat="" colspan="2" class=" over_header center" style="left: -32px; position: sticky; text-align: right; z-index: 20; border-right: 1px solid rgb(148, 150, 152);"></th> <th aria-label="" data-stat="header_playing" colspan="4" class="over_header center group_start not_sticky">Playing Time</th> <th aria-label="" data-stat="header_performance" colspan="10" class="over_header center group_start not_sticky">Performance</th> <th aria-label="" data-stat="header_pk" colspan="5" class="over_header center group_start not_sticky">Penalty Kicks</th> </tr> <tr> <th aria-label="Squad" data-stat="team" scope="col" class=" poptip sort_default_asc center">Squad</th> <th aria-label="# of Players" data-stat="players_used" scope="col" class=" poptip center" data-tip="&lt;strong&gt;# of Players&lt;/strong&gt;&lt;br&gt;Number of Players used in Games"># Pl</th> <th aria-label="Matches Played" data-stat="gk_games" scope="col" class=" poptip center group_start" data-tip="&lt;strong&gt;Matches Played&lt;/strong&gt;&lt;br&gt;Matches Played by the player or squad" data-over-header="Playing Time">MP</th> <th aria-label="Starts" data-stat="gk_games_starts" scope="col" class=" poptip center" data-tip="Game or games started by player" data-over-header="Playing Time">Starts</th> <th aria-label="Minutes" data-stat="gk_minutes" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Minutes&lt;/strong&gt;&lt;br&gt;" data-over-header="Playing Time">Min</th> <th aria-label="90s Played" data-stat="minutes_90s" scope="col" class=" poptip center" data-tip="&lt;strong&gt;90s Played&lt;/strong&gt;&lt;br&gt;&lt;strong&gt;90s played&lt;/strong&gt;&lt;br&gt;Minutes played divided by 90" data-over-header="Playing Time">90s</th> <th aria-label="Goals Against" data-stat="gk_goals_against" scope="col" class=" poptip center group_start" data-tip="&lt;strong&gt;Goals Against&lt;/strong&gt;&lt;br&gt;Goals Against" data-over-header="Performance">GA</th> <th aria-label="Goals Against/90" data-stat="gk_goals_against_per90" scope="col" class=" poptip sort_default_asc hide_non_quals center" data-tip="&lt;strong&gt;Goals Against/90&lt;/strong&gt;&lt;br&gt;Goals Against per 90 minutes" data-over-header="Performance" data-filter="1" data-name="Goals Against/90">GA90</th> <th aria-label="Shots on Target Against" data-stat="gk_shots_on_target_against" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Shots on Target Against&lt;/strong&gt;&lt;br&gt;Shots on Target Against" data-over-header="Performance">SoTA</th> <th aria-label="Saves" data-stat="gk_saves" scope="col" class=" poptip center" data-over-header="Performance">Saves</th> <th aria-label="Save Percentage" data-stat="gk_save_pct" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Save Percentage&lt;/strong&gt;&lt;br&gt;Save Percentage&lt;br&gt;(Shots on Target Against - Goals Against)/Shots on Target Against&lt;br&gt;Note that not all shots on target are stopped by the keeper, many will be stopped by defenders" data-over-header="Performance" data-filter="1" data-name="Save Percentage">Save%</th> <th aria-label="Wins" data-stat="gk_wins" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Wins&lt;/strong&gt;&lt;br&gt;Wins" data-over-header="Performance">W</th> <th aria-label="Draws" data-stat="gk_ties" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Draws&lt;/strong&gt;&lt;br&gt;Draws" data-over-header="Performance">D</th> <th aria-label="Losses" data-stat="gk_losses" scope="col" class=" poptip center" data-tip="&lt;