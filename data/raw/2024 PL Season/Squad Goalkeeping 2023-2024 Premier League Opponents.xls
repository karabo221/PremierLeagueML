<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Worksheet</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>   <thead> <tr class="over_header"> <th aria-label="" data-stat="" colspan="3" class=" over_header center"></th> <th aria-label="" data-stat="header_standard" colspan="10" class=" over_header center group_start">Standard</th> </tr> <tr> <th aria-label="Squad" data-stat="team" scope="col" class=" poptip sort_default_asc center">Squad</th> <th aria-label="# of Players" data-stat="players_used" scope="col" class=" poptip center" data-tip="&lt;strong&gt;# of Players&lt;/strong&gt;&lt;br&gt;Number of Players used in Games"># Pl</th> <th aria-label="90s Played" data-stat="minutes_90s" scope="col" class=" poptip center" data-tip="&lt;strong&gt;90s Played&lt;/strong&gt;&lt;br&gt;&lt;strong&gt;90s played&lt;/strong&gt;&lt;br&gt;Minutes played divided by 90">90s</th> <th aria-label="Goals" data-stat="goals" scope="col" class=" poptip center group_start" data-tip="&lt;strong&gt;Goals&lt;/strong&gt;&lt;br&gt;Goals scored or allowed" data-over-header="Standard">Gls</th> <th aria-label="Shots Total" data-stat="shots" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Shots Total&lt;/strong&gt;&lt;br&gt;Shots Total" data-over-header="Standard">Sh</th> <th aria-label="Shots on Target" data-stat="shots_on_target" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Shots on Target&lt;/strong&gt;&lt;br&gt;Shots on Target" data-over-header="Standard">SoT</th> <th aria-label="Shots on Target %" data-stat="shots_on_target_pct" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Shots on Target %&lt;/strong&gt;&lt;br&gt;Percentage of shots that are on target&lt;br&gt;Minimum .395 shots per squad game to qualify as a leader" data-over-header="Standard" data-filter="1" data-name="Shots on Target %">SoT%</th> <th aria-label="Shots Total/90" data-stat="shots_per90" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Shots Total/90&lt;/strong&gt;&lt;br&gt;Shots total per 90 minutes&lt;br&gt;Minimum 30 minutes played per squad game to qualify as a leader" data-over-header="Standard" data-filter="1" data-name="Shots Total/90">Sh/90</th> <th aria-label="Shots on target/90" data-stat="shots_on_target_per90" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Shots on target/90&lt;/strong&gt;&lt;br&gt;Shots on target per 90 minutes&lt;br&gt;Minimum 30 minutes played per squad game to qualify as a leader" data-over-header="Standard" data-filter="1" data-name="Shots on target/90">SoT/90</th> <th aria-label="Goals/Shot" data-stat="goals_per_shot" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Goals/Shot&lt;/strong&gt;&lt;br&gt;Goals per shot&lt;br&gt;Minimum .395 shots per squad game to qualify as a leader" data-over-header="Standard" data-filter="1" data-name="Goals/Shot">G/Sh</th> <th aria-label="Goals/Shot on Target" data-stat="goals_per_shot_on_target" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Goals/Shot on Target&lt;/strong&gt;&lt;br&gt;Goals per shot on target&lt;br&gt;Minimum .111 shots on target per squad game to qualify as a leader" data-over-header="Standard" data-filter="1" data-name="Goals/Shot on Target">G/SoT</th> <th aria-label="Penalty Kicks Made" data-stat="pens_made" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Penalty Kicks Made&lt;/strong&gt;&lt;br&gt;Penalty Kicks Made" data-over-header="Standard">PK</th> <th aria-label="Penalty Kicks Attempted" data-stat="pens_att" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Penalty Kicks Attempted&lt;/strong&gt;&lt;br&gt;Penalty Kicks A